# Local Docker Compose database only. Never put production credentials here.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hermes?sslmode=disable

SESSION_COOKIE_SECURE=false

# Stripe configuration (sandbox / test mode)
STRIPE_API_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MODE=sandbox
PUBLIC_BASE_URL=http://localhost:3000
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=pmc_...
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Optional, sandbox testing only: installments fall due this far apart instead of monthly. Refused when STRIPE_MODE=live.
# INSTALLMENT_SPACING=15m
